# --- Production .env for uFeed (copy to .env on the Beelink) ---
# Generate strong secrets, e.g.:
#   openssl rand -base64 36

# Postgres
POSTGRES_USER=ufeed
POSTGRES_PASSWORD=CHANGE-ME-strong-db-password
POSTGRES_DB=ufeed
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://ufeed:CHANGE-ME-strong-db-password@db:5432/ufeed
DATABASE_URL_SYNC=postgresql+psycopg://ufeed:CHANGE-ME-strong-db-password@db:5432/ufeed

# Redis
REDIS_URL=redis://cache:6379/0

# Auth — MUST be a long random string
JWT_SECRET=CHANGE-ME-long-random-jwt-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# AI service
AI_URL=http://ai:8001
AI_ENABLED=true
# Start with 'hashing' (no drivers needed); switch to 'openvino' once the Intel
# runtime is installed and you add -f compose.openvino.yml.
AI_BACKEND=hashing
AI_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Use GPU (Intel iGPU) for embeddings — ~12x CPU on Wildcat Lake. The NPU is
# NOT suitable here: it needs static shapes and these embeddings are dynamic
# (variable token length). NPU is for static-shape models (e.g. YOLO/Frigate).
OPENVINO_DEVICE=GPU

# App
ENV=prod
LOG_LEVEL=info
DEFAULT_LOCALE=es

# --- TLS handled by Cosmos (QNAP) reverse proxy ---
# Leave UFEED_DOMAIN UNSET so uFeed's own Caddy serves plain HTTP; Cosmos does
# the domain + certificate and forwards to http://<beelink-ip>:UFEED_HTTP_PORT.
# UFEED_DOMAIN=
UFEED_HTTP_PORT=8080
# The public URL users hit (through Cosmos). Same-origin SPA, so this is only a
# safety net for cross-origin calls:
CORS_ORIGINS=https://feeds.example.com

# --- If instead you want uFeed to terminate HTTPS itself (no external proxy) ---
# set UFEED_DOMAIN=feeds.example.com and expose 80/443 (defaults).
