# uFeed reverse proxy.
# Local dev: browse http://localhost (UFEED_DOMAIN unset -> listens on :80).
# Production: set UFEED_DOMAIN=feeds.example.com and Caddy auto-provisions HTTPS.
{$UFEED_DOMAIN::80} {
	encode gzip

	header {
		# Security headers (applied to every response).
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	# API (internal + public) -> backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}

	# Everything else -> the SvelteKit SPA (served by the frontend container).
	handle {
		reverse_proxy frontend:80
	}
}
