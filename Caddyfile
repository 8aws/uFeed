# uFeed reverse proxy (WS0 baseline; hardened in WS6).
# Local dev: browse http://localhost
:80 {
	# API (internal + public) -> backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}

	# Everything else -> the SvelteKit SPA (served by the frontend container).
	handle {
		reverse_proxy frontend:80
	}
}
