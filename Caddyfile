# uFeed reverse proxy (WS0 baseline; hardened in WS6).
# Local dev: browse http://localhost
:80 {
	# API (internal + public) -> backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}

	# Frontend -> added in WS5. For now, point root at the backend health page.
	handle {
		reverse_proxy backend:8000
	}
}
