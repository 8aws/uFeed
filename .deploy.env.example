# Copy to .deploy.env (gitignored) on the machine you deploy from.
DEPLOY_HOST=user@192.168.1.10          # ssh target of the production box
DEPLOY_PATH=/srv/ufeed                 # stack directory on the box
DEPLOY_PUBLIC_URL=https://feeds.example.com
