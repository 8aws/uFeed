# uFeed reverse proxy.
# Local dev: browse http://localhost (UFEED_DOMAIN unset -> listens on :80).
# Production: set UFEED_DOMAIN=feeds.example.com and Caddy auto-provisions HTTPS,
# or leave it unset behind an external TLS proxy (e.g. Cosmos on a QNAP).
{
	servers {
		# Trust X-Forwarded-For only from the external proxy so the backend sees
		# real client IPs (per-IP login/sign-up rate limits). Narrow it with
		# TRUSTED_PROXIES=<proxy ip>/32 in .env.
		trusted_proxies static {$TRUSTED_PROXIES:private_ranges}
		client_ip_headers X-Forwarded-For X-Real-IP
	}
}

# Everything the app serves, shared by the public entry and the administration
# entry below.
(ufeed_app) {
	encode gzip

	header {
		defer
		# Security headers (applied to every response).
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		# Don't advertise the software stack.
		-Server
		-Via
		-X-Powered-By
	}

	# Scanners probe for secrets and admin panels (.env, .git, wp-login...).
	# Answer with a plain 404 instead of the SPA shell, which looks like a hit.
	@dotfile {
		path_regexp /\.
		not path /.well-known/*
	}
	@probe path *.php *.env *.ini *.sql *.bak *.old *.swp *.yml *.yaml *.conf *.cfg *.log *.sh *.gz *.zip *.tar *.tgz *Caddyfile *Dockerfile /backups/* /scripts/* /wp-* /cgi-bin/* /server-status* /phpmyadmin* /vendor/*
	# (`handle` runs before `respond` in Caddy's directive order, so these must
	# be handle blocks listed before the catch-all below.)
	handle @dotfile {
		respond 404
	}
	handle @probe {
		respond 404
	}

	# API (internal + public) -> backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}
	# API docs are disabled in production (ENV=prod) and 404 there.
	handle /openapi.json {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}

	# Everything else -> the SvelteKit SPA (served by the frontend container).
	handle {
		reverse_proxy frontend:80
	}
}

# Public entry (the one Cosmos publishes). Administration is NOT served here:
# the page and its API answer 404, so a stolen password or session on the public
# internet can't reach it. It lives on the local entry below.
{$UFEED_DOMAIN::80} {
	handle /api/admin* {
		header Content-Type application/json
		respond `{"error":{"code":"admin_local_only","message":"Administration is only available from the local network."}}` 404
	}
	handle /admin* {
		respond "Administration is only available from the local network." 404
	}
	import ufeed_app
}

# Local entry: the same site WITH administration. Published by docker-compose on
# UFEED_ADMIN_BIND:UFEED_ADMIN_PORT (127.0.0.1:8197 unless .env says otherwise;
# on the Beelink 0.0.0.0:8197, reachable only from the LAN because the router
# forwards just 80/443 to Cosmos). NEVER add a Cosmos route to this port.
:8081 {
	import ufeed_app
}
