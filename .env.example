# --- Postgres ---
POSTGRES_USER=ufeed
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ufeed
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ---
REDIS_URL=redis://cache:6379/0

# --- Backend ---
# Full async DSN used by SQLAlchemy/asyncpg (overrides the POSTGRES_* pieces if set)
DATABASE_URL=postgresql+asyncpg://ufeed:change-me@db:5432/ufeed
# Sync DSN used by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg://ufeed:change-me@db:5432/ufeed

# JWT (used from WS1 onwards)
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# App
ENV=dev
LOG_LEVEL=info
# Uncomment and set to a public hostname to enable automatic HTTPS.
# Leave it UNSET (commented) for local HTTP on :80.
# UFEED_DOMAIN=feeds.example.com
# Comma-separated origins for CORS (frontend dev server, etc.)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEFAULT_LOCALE=en
